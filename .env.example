SECRET_KEY=replace-with-a-long-random-string

MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Google OAuth (for "Continue with Google" login) ---
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth client ID of type "Web application".
# 3. Add an Authorized redirect URI: http://127.0.0.1:5000/login/google/authorize
# 4. Paste the generated values below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Example: Gmail (use a Google App Password, not your main password) ---
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-google-app-password
# MAIL_DEFAULT_SENDER=you@gmail.com

# --- Example: Outlook / Office 365 ---
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=you@outlook.com
# MAIL_PASSWORD=your-password
# MAIL_DEFAULT_SENDER=you@outlook.com

# --- Example: Yahoo Mail (use an App Password) ---
# MAIL_SERVER=smtp.mail.yahoo.com
# MAIL_PORT=465
# MAIL_USE_TLS=false
# MAIL_USE_SSL=true
# MAIL_USERNAME=you@yahoo.com
# MAIL_PASSWORD=your-yahoo-app-password
# MAIL_DEFAULT_SENDER=you@yahoo.com
