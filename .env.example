SECRET_KEY=replace-with-a-long-random-string

MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Example: Gmail (use a Google App Password, not your main password) ---
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-google-app-password
# MAIL_DEFAULT_SENDER=you@gmail.com

# --- Example: Outlook / Office 365 ---
