SECRET_KEY=appointment-system-secret-key-2024

# --- Gmail SMTP setup (REQUIRED: fill in MAIL_USERNAME and MAIL_PASSWORD below) ---
# IMPORTANT: For MAIL_PASSWORD, do NOT use your regular Gmail password.
# 1. Turn ON 2-Step Verification on your Google account.
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password (16 characters, no spaces). Paste it into MAIL_PASSWORD.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Google OAuth Setup (REQUIRED for Google Direct Login) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
